{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design-system-exercise.local/schema/ai-test-pack.schema.json",
  "title": "Design System Exercise AI test pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "kind",
    "version",
    "status",
    "name",
    "taskIds",
    "agentContext",
    "blindProtocol",
    "evaluationDimensions",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "const": "dse.ai-eval-pack.v1"
    },
    "kind": {
      "const": "ai-test-pack"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "taskIds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^dse\\.ai-eval\\.[a-z0-9.-]+$"
      }
    },
    "agentContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "deny"
      ],
      "properties": {
        "allow": {
          "$ref": "#/definitions/stringArray"
        },
        "deny": {
          "$ref": "#/definitions/stringArray"
        }
      }
    },
    "blindProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshSessionPerTask",
        "freshWorktreePerTask",
        "agentReceivesOnlyAgentVisibleTaskData",
        "neverExposeEvaluatorOnly",
        "noCrossRunReuse",
        "generatedOutputReadableWithinTask",
        "noRepositoryHistoryForAnswers",
        "noExternalAnswerLookup",
        "noHumanCorrectionDuringRun",
        "verificationCommandsMayTransitivelyProcessDeniedSource",
        "deniedSourceRemainsNonAuthoringContextDuringVerification"
      ],
      "properties": {
        "freshSessionPerTask": {
          "const": true
        },
        "freshWorktreePerTask": {
          "const": true
        },
        "agentReceivesOnlyAgentVisibleTaskData": {
          "const": true
        },
        "neverExposeEvaluatorOnly": {
          "const": true
        },
        "noCrossRunReuse": {
          "const": true
        },
        "noRepositoryHistoryForAnswers": {
          "const": true
        },
        "noExternalAnswerLookup": {
          "const": true
        },
        "noHumanCorrectionDuringRun": {
          "const": true
        },
        "generatedOutputReadableWithinTask": {
          "const": true
        },
        "verificationCommandsMayTransitivelyProcessDeniedSource": {
          "const": true
        },
        "deniedSourceRemainsNonAuthoringContextDuringVerification": {
          "const": true
        }
      }
    },
    "evaluationDimensions": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "component-selection",
          "invented-api",
          "custom-css",
          "raw-values",
          "composition",
          "accessibility",
          "rtl",
          "responsive",
          "visual-fidelity"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lastReviewed",
        "plan"
      ],
      "properties": {
        "lastReviewed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "plan": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
