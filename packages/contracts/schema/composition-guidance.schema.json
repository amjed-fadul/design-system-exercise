{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design-system-exercise.local/schema/composition-guidance.schema.json",
  "title": "Design System Exercise composition guidance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "kind",
    "version",
    "status",
    "name",
    "description",
    "scope",
    "componentDependencies",
    "patternDependencies",
    "structure",
    "rules",
    "localCss",
    "forbidden",
    "provenance"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^dse\\.composition\\.[a-z0-9.-]+$" },
    "kind": { "const": "composition-guidance" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["page", "interaction", "flow"] },
    "componentDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/componentDependency" }
    },
    "patternDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/patternDependency" }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "order", "required", "role"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "order": { "type": "integer", "minimum": 1 },
          "required": { "type": "boolean" },
          "role": { "type": "string", "minLength": 1 },
          "componentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^dse\\.(?!_)[a-z0-9.-]+$" }
          },
          "patternIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^dse\\.pattern\\.[a-z0-9.-]+$" }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "responsive", "direction", "accessibility", "behavior"],
      "properties": {
        "layout": { "$ref": "#/definitions/ruleArray" },
        "responsive": { "$ref": "#/definitions/ruleArray" },
        "direction": { "$ref": "#/definitions/ruleArray" },
        "accessibility": { "$ref": "#/definitions/ruleArray" },
        "behavior": { "$ref": "#/definitions/ruleArray" }
      }
    },
    "localCss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "mustUseGovernedTokensWhenAvailable"],
      "properties": {
        "allowed": { "$ref": "#/definitions/ruleArray" },
        "mustUseGovernedTokensWhenAvailable": { "const": true }
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastReviewed", "audit", "evidence"],
      "properties": {
        "lastReviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "audit": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "componentDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^dse\\.(?!_)[a-z0-9.-]+$" },
        "minimumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "patternDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^dse\\.pattern\\.[a-z0-9.-]+$" },
        "minimumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "ruleArray": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule" }
    }
  }
}
