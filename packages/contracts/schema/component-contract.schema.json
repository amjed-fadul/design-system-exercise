{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design System Exercise component contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "kind",
    "version",
    "status",
    "visibility",
    "name",
    "description",
    "sources",
    "publicApi",
    "representations",
    "anatomy",
    "tokenDependencies",
    "states",
    "semantics",
    "composition",
    "events",
    "forbidden",
    "provenance"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^dse\\._?[a-z0-9.-]+$" },
    "kind": { "const": "component" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "visibility": { "enum": ["public", "internal"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figma"],
      "properties": {
        "figma": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileKey", "nodeId"],
          "properties": {
            "fileKey": { "type": "string", "minLength": 1 },
            "nodeId": { "type": "string", "pattern": "^\\d+:\\d+$" }
          }
        },
        "implementationPackage": { "type": "string", "minLength": 1 }
      }
    },
    "publicApi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["props", "forwardNativeAttributes"],
      "properties": {
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "default": {},
              "type": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["enum"],
                    "properties": {
                      "enum": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["boolean"],
                    "properties": { "boolean": { "const": true } }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["content"],
                    "properties": { "content": { "const": true } }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["native"],
                    "properties": { "native": { "const": true } }
                  }
                ]
              }
            }
          }
        },
        "forwardNativeAttributes": { "type": "boolean" }
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "kind", "mapsTo"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["public", "derived", "figma-only", "native"] },
          "mapsTo": { "type": "string", "minLength": 1 }
        }
      }
    },
    "anatomy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tokenDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ownership", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ownership": { "enum": ["public", "native", "derived"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "accessibleName", "keyboardActivation", "focus"],
      "properties": {
        "element": { "type": "string", "minLength": 1 },
        "accessibleName": { "type": "string", "minLength": 1 },
        "keyboardActivation": { "type": "string", "minLength": 1 },
        "focus": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optional", "description"],
        "properties": {
          "optional": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "accessibleNameOwner": { "type": "string", "minLength": 1 },
          "allowedChildren": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "trigger"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "suppressedWhen": { "type": "string", "minLength": 1 }
        }
      }
    },
    "forbidden": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastReviewed", "references"],
      "properties": {
        "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
