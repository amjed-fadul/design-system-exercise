{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design-system-exercise.local/schema/ai-blind-authoring-task.schema.json",
  "title": "Design System Exercise blind AI authoring task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "kind",
    "version",
    "status",
    "name",
    "caseType",
    "agentVisible",
    "evaluatorOnly",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^dse\\.ai-eval\\.[a-z0-9.-]+$"
    },
    "kind": {
      "const": "ai-blind-authoring-task"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "caseType": {
      "enum": [
        "baseline-known",
        "generalization"
      ]
    },
    "agentVisible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productRequirement",
        "deliverable",
        "executionRules"
      ],
      "properties": {
        "productRequirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "userGoals",
            "dataFixtures",
            "requiredStates",
            "presentationModes"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "userGoals": {
              "$ref": "#/definitions/stringArray"
            },
            "dataFixtures": {
              "$ref": "#/definitions/stringArray"
            },
            "requiredStates": {
              "$ref": "#/definitions/stringArray"
            },
            "presentationModes": {
              "$ref": "#/definitions/stringArray"
            }
          }
        },
        "deliverable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "writeRoot",
            "requiredFiles",
            "storyTitle"
          ],
          "properties": {
            "writeRoot": {
              "type": "string",
              "pattern": "^apps/storybook/src/ai-readiness/evaluations/[a-z0-9-]+/$"
            },
            "requiredFiles": {
              "$ref": "#/definitions/stringArray"
            },
            "storyTitle": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "executionRules": {
          "$ref": "#/definitions/stringArray"
        },
        "productContextIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dse\\.product-context\\.[a-z0-9.-]+$"
          }
        }
      }
    },
    "evaluatorOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedAuthorities",
        "checks",
        "expectedEscalations",
        "contaminationSignals"
      ],
      "properties": {
        "expectedAuthorities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "components",
            "patterns",
            "compositions"
          ],
          "properties": {
            "components": {
              "$ref": "#/definitions/idArray"
            },
            "patterns": {
              "$ref": "#/definitions/idArray"
            },
            "compositions": {
              "$ref": "#/definitions/idArray"
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "category",
              "requirement",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]+$"
              },
              "category": {
                "enum": [
                  "component-selection",
                  "invented-api",
                  "custom-css",
                  "raw-values",
                  "composition",
                  "accessibility",
                  "rtl",
                  "responsive",
                  "visual-fidelity"
                ]
              },
              "requirement": {
                "enum": [
                  "must",
                  "must-not",
                  "expected"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "expectedEscalations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contaminationSignals": {
          "$ref": "#/definitions/stringArray"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lastReviewed",
        "plan"
      ],
      "properties": {
        "lastReviewed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "plan": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^dse\\.[a-z0-9._-]+$"
      }
    }
  }
}
