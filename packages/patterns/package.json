{
  "name": "@design-system-exercise/patterns",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["./dist/styles.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm --filter @design-system-exercise/react build && pnpm --filter @design-system-exercise/tokens build && pnpm build && node scripts/verify-application-shell-dist.mjs"
  },
  "dependencies": {
    "@design-system-exercise/react": "workspace:*",
    "@design-system-exercise/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
