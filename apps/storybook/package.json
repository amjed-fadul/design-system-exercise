{
  "name": "@design-system-exercise/storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "storybook": "pnpm --filter @design-system-exercise/react build && storybook dev -p 6006",
    "build-storybook": "pnpm --filter @design-system-exercise/react build && storybook build -o storybook-static",
    "test": "pnpm --filter @design-system-exercise/react build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@design-system-exercise/react": "workspace:*",
    "@design-system-exercise/tokens": "workspace:*",
    "@fontsource/geist": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
